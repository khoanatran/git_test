 }
+
+const DATE_KEY_RE = /^(\d{4}-\d{2}-\d{2})/
+
+export function getLiveFromDate(
+  manifest: { liveFromDate?: string | null } | null | undefined
+): string | null {
+  const value = manifest?.liveFromDate?.trim()
+  return value && DATE_KEY_RE.test(value) ? value : null
+}
+
+export function dateKeyFromTimestamp(value: string | null | undefined): string | null {
+  if (!value) return null
+  const match = String(value).trim().match(DATE_KEY_RE)
+  return match ? match[1] : null
+}
+
+export function dateKeyFromMetadataKey(key: string): string | null {
+  const match = key.match(/(\d{4}-\d{2}-\d{2})/)
+  return match ? match[1] : null
+}
+
+export function isOnOrAfterLiveFromDate(
+  dayKey: string | null | undefined,
+  liveFromDate: string | null | undefined
+): boolean {
+  if (!liveFromDate) return true
+  if (!dayKey) return true
+  return dayKey >= liveFromDate
+}
+
+export function tradeBelongsToLiveSession(
+  trade: { exitTime?: string | null; timestamp?: string | null; entryTime?: string | null },
+  manifest: { liveFromDate?: string | null } | null | undefined
+): boolean {
+  const liveFromDate = getLiveFromDate(manifest)
+  if (!liveFromDate) return true
+  const dayKey =
+    dateKeyFromTimestamp(trade.exitTime) ??
+    dateKeyFromTimestamp(trade.timestamp) ??
+    dateKeyFromTimestamp(trade.entryTime)
+  return isOnOrAfterLiveFromDate(dayKey, liveFromDate)
+}
+
+export function filterTradesToLiveSession<
+  T extends { exitTime?: string | null; timestamp?: string | null; entryTime?: string | null },
+>(trades: T[], manifest: { liveFromDate?: string | null } | null | undefined): T[] {
+  if (!getLiveFromDate(manifest)) return trades
+  return trades.filter(trade => tradeBelongsToLiveSession(trade, manifest))
+}
+
+export function filterRecordKeysToLiveSession<T>(
+  record: Record<string, T>,
+  manifest: { liveFromDate?: string | null } | null | undefined
+): Record<string, T> {
+  const liveFromDate = getLiveFromDate(manifest)
+  if (!liveFromDate) return record
+  const out: Record<string, T> = {}
+  for (const [key, value] of Object.entries(record)) {
+    if (isOnOrAfterLiveFromDate(dateKeyFromMetadataKey(key), liveFromDate)) {
+      out[key] = value
+    }
+  }
+  return out
+}
diff --git a/lib/live-session-window.ts b/lib/live-session-window.ts
new file mode 100644
index 0000000..7478bc5
--- /dev/null
+++ b/lib/live-session-window.ts
@@ -0,0 +1,84 @@
+import fs from 'fs/promises'
+import path from 'path'
+import {
+  filterRecordKeysToLiveSession,
+  filterTradesToLiveSession,
+  getLiveFromDate,
+  isOnOrAfterLiveFromDate,
+  type LiveSessionManifest,
+} from '@/lib/live-session-utils'
+import { readLiveSessionManifest } from '@/lib/live-session-server'
+import { loadTradesSnapshotData, saveTradesSnapshot } from '@/lib/trades-snapshot-server'
+
+const DATA_DIR = path.join(process.cwd(), 'data')
+
+async function readJson<T>(fileName: string, fallback: T): Promise<T> {
+  try {
+    const raw = await fs.readFile(path.join(DATA_DIR, fileName), 'utf-8')
+    return JSON.parse(raw) as T
+  } catch {
+    return fallback
+  }
+}
+
+async function writeJson(fileName: string, value: unknown): Promise<boolean> {
+  const filePath = path.join(DATA_DIR, fileName)
+  const next = `${JSON.stringify(value, null, 2)}\n`
+  try {
+    const current = await fs.readFile(filePath, 'utf-8')
+    if (current === next) return false
+  } catch {
+    // missing
+  }
+  await fs.mkdir(DATA_DIR, { recursive: true })
+  await fs.writeFile(filePath, next, 'utf-8')
+  return true
+}
+
+/**
+ * Drop archived-period rows that git merge / MT5 re-imported into the Live Dashboard.
+ * Live keeps trades on/after live-session.json liveFromDate.
+ */
+export async function applyLiveSessionDateWindow(
+  manifest?: LiveSessionManifest | null
+): Promise<{ changed: boolean; tradesRemoved: number; tradeCount: number }> {
+  const liveSession = manifest === undefined ? await readLiveSessionManifest() : manifest
+  const liveFromDate = getLiveFromDate(liveSession)
+  if (!liveFromDate) {
+    const snapshot = await loadTradesSnapshotData()
+    return { changed: false, tradesRemoved: 0, tradeCount: snapshot.trades.length }
+  }
+
+  const before = await loadTradesSnapshotData()
+  const filteredTrades = filterTradesToLiveSession(before.trades, liveSession)
+  const tradesRemoved = before.trades.length - filteredTrades.length
+  let changed = false
+
+  if (tradesRemoved > 0) {
+    await saveTradesSnapshot(filteredTrades, { skipBackup: true, skipDateWindow: true })
+    changed = true
+  }
+
+  const flags = await readJson<{
+    _v?: number
+    days?: Record<string, boolean>
+    trades?: Record<string, boolean>
+  }>('flags.json', { _v: 1, days: {}, trades: {} })
+  const nextFlags = {
+    _v: flags._v ?? 1,
+    days: Object.fromEntries(
+      Object.entries(flags.days ?? {}).filter(([day]) =>
+        isOnOrAfterLiveFromDate(day, liveFromDate)
+      )
+    ),
+    trades: filterRecordKeysToLiveSession(flags.trades ?? {}, liveSession),
+  }
+  if (await writeJson('flags.json', nextFlags)) changed = true
+
+  const tags = await readJson<Record<string, string[]>>('trade-tags.json', {})
+  const nextTags = filterRecordKeysToLiveSession(tags, liveSession)
+  if (await writeJson('trade-tags.json', nextTags)) changed = true
+
+  const after = await loadTradesSnapshotData()
+  return { changed, tradesRemoved, tradeCount: after.trades.length }
+}
