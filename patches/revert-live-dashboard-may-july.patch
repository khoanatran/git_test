diff --git a/app/page.tsx b/app/page.tsx
index 4e564dd..ce2704a 100644
--- a/app/page.tsx
+++ b/app/page.tsx
@@ -54,6 +54,7 @@ import {
   type DashboardArchiveSummary,
 } from '@/lib/archive-client'
 import { fetchLiveSessionInfo, updateLiveSessionImport } from '@/lib/session-client'
+import { filterTradesToLiveSession } from '@/lib/live-session-utils'
 
 type DateRange = { from?: Date; to?: Date }
 
@@ -470,15 +471,26 @@ export default function Home() {
     const replaceStaleSessionData = Boolean(
       liveInfo?.liveSession?.previousArchiveTitle && !liveInfo.liveSession.lastImportFile
     )
+    const liveParsedTrades = filterTradesToLiveSession(parsedTrades, liveInfo?.liveSession)
+    const archivedSkipped = parsedTrades.length - liveParsedTrades.length
+    if (liveParsedTrades.length === 0) {
+      alert(
+        archivedSkipped > 0
+          ? `None of the ${archivedSkipped} trade(s) belong on Live Dashboard (on/after ${liveInfo?.liveSession?.liveFromDate}). They stay in the archive.`
+          : 'No completed trades found in the file. Please check the file format.'
+      )
+      return
+    }
 
     setTrades(prev => {
       const baseTrades = replaceStaleSessionData ? [] : prev
-      const { merged, added, skipped } = mergeImportedTrades(baseTrades, parsedTrades)
+      const { merged, added, skipped } = mergeImportedTrades(baseTrades, liveParsedTrades)
       const tradesWithRR = merged.filter(t => getTradeRMultiple(t) !== null)
       const totalPnl = merged.reduce((sum, t) => sum + (t.pnl ?? 0), 0)
       console.log(
-        `Import "${fileLabel}": parsed ${parsedTrades.length}, added ${added}, skipped ${skipped} duplicate(s). ` +
-          `Total ${merged.length} trades (${tradesWithRR.length} with R:R, P&L ${formatUsdPnl(totalPnl)})` +
+        `Import "${fileLabel}": parsed ${parsedTrades.length}, added ${added}, skipped ${skipped} duplicate(s)` +
+          (archivedSkipped > 0 ? `, ${archivedSkipped} archived-period` : '') +
+          `. Total ${merged.length} trades (${tradesWithRR.length} with R:R, P&L ${formatUsdPnl(totalPnl)})` +
           (replaceStaleSessionData ? ' [new session — replaced stale data]' : '')
       )
 
@@ -507,11 +519,19 @@ export default function Home() {
           )
         } else if (skipped > 0) {
           alert(
-            `Added ${added} new trade(s). Skipped ${skipped} duplicate(s) already saved. Total: ${merged.length} trades.\n\nTrade export updated in ${getTradeExportFilePath()}.`
+            `Added ${added} new trade(s). Skipped ${skipped} duplicate(s) already saved.` +
+              (archivedSkipped > 0
+                ? ` Left ${archivedSkipped} archived-period trade(s) off Live Dashboard.`
+                : '') +
+              ` Total: ${merged.length} trades.\n\nTrade export updated in ${getTradeExportFilePath()}.`
           )
         } else {
           alert(
-            `Added ${added} new trade(s). Total: ${merged.length} trades saved locally.\n\nTrade export updated in ${getTradeExportFilePath()}.`
+            `Added ${added} new trade(s).` +
+              (archivedSkipped > 0
+                ? ` Left ${archivedSkipped} archived-period trade(s) off Live Dashboard.`
+                : '') +
+              ` Total: ${merged.length} trades saved locally.\n\nTrade export updated in ${getTradeExportFilePath()}.`
           )
         }
       }
